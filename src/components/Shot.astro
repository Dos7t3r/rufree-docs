---
/**
 * A screenshot slot. While `src` is unset it renders a labelled placeholder so the
 * page reads correctly before the image exists, and so every outstanding screenshot
 * is visible on the page itself.
 *
 * Usage:
 *   <Shot id="timetable-import-01" caption="..." alt="..." />
 *   <Shot id="timetable-import-01" caption="..." alt="..." src={importShot} />
 */
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  /** Stable id used in the screenshot checklist. */
  id: string;
  /** Shown under the image. */
  caption: string;
  /** Alternative text. Required whenever src is set. */
  alt: string;
  /** Imported image. Omit while the screenshot is outstanding. */
  src?: ImageMetadata;
}

const { id, caption, alt, src } = Astro.props;
---

<figure class="shot">
  {
    src ? (
      <Image src={src} alt={alt} class="shot-img" loading="lazy" />
    ) : (
      <div class="shot-missing" role="img" aria-label={`Screenshot pending: ${caption}`}>
        <span class="shot-missing-tag">截图待补 · screenshot pending</span>
        <code class="shot-missing-id">{id}</code>
      </div>
    )
  }
  <figcaption>{caption}</figcaption>
</figure>

<style>
  .shot {
    margin: 1.5rem 0;
  }
  .shot-img {
    width: 100%;
    height: auto;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
  }
  .shot-missing {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-height: 9rem;
    padding: 1.5rem 1rem;
    border: 1px dashed var(--sl-color-gray-4);
    border-radius: 0.5rem;
    background: var(--sl-color-gray-7, var(--sl-color-gray-6));
    text-align: center;
  }
  .shot-missing-tag {
    font-size: var(--sl-text-xs);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--sl-color-gray-3);
  }
  .shot-missing-id {
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-2);
  }
  figcaption {
    margin-top: 0.5rem;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
    text-align: center;
  }
</style>
